# MediSphere AI - Configuration Template
# Copy this file to .env and configure values before starting the application.

# 1. Project Information
PROJECT_NAME="MediSphere AI"
API_V1_STR="/api/v1"

# 2. Database Connections
# Defaults to a local SQLite database for easy development fallback
DATABASE_URL="sqlite:///./medisphere.db"
# For production, configure your PostgreSQL database connection:
# DATABASE_URL="postgresql://user:password@localhost:5432/medisphere"

# 3. Security & Hashing
# CRITICAL: Change this secret key in production!
SECRET_KEY="super-secret-key-change-in-production-guideline"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 Days

# 4. Redis Caching
REDIS_URL="redis://localhost:6379/0"

# 5. Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="medisphere-documents"
